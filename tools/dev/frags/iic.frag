const ag=el('g',{});ag.appendChild(el('circle',{cx:AX-44,cy:44,r:11,fill:'#1a2338',stroke:'#5cb3f2'}));
tx(ag,AX+8,40,'1135 BC [2670 AM]',{fill:'#ffcf5c','font-size':14,class:'mono','font-weight':500});
tx(ag,AX+8,56,'Comet darkens the sun',{fill:'#ffcf5c','font-size':11.5,class:'mono'});
svg.appendChild(ag);bind(ag,T('1135 BC [2670 AM]','#ffcf5c','comet darkens the sun','As written: 1135 BC is 2760 AM (3895 − 1135), as chart II·b gives it.'));
