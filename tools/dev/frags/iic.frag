for(let y=-2000;y<=2000;y+=500)tx(svg,X(y===0?1:y)+4,AXIS+4,y<0?(-y)+' BC':(y?y+' AD':'1 AD'),{fill:'#aeb7cd','font-size':10,class:'mono'});
