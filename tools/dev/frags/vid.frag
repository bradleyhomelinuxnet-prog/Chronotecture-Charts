svg.appendChild(ag);bind(ag,T('622 AD [4516 AM]','#ffcf5c','Islamic Hijrah Calendar','Hijrah Year One.'));
const kg=el('g',{});kg.appendChild(el('rect',{x:860,y:58,width:28,height:34,rx:3,fill:'#0a0d14',stroke:'#5d6885'}));
tx(kg,898,72,'Principle icon of a black',{fill:'#aeb7cd','font-size':11});tx(kg,898,88,'meteoric rock in Kaaba',{fill:'#aeb7cd','font-size':11});
bind(kg,T('The Kaaba stone','#aeb7cd','','Principle icon of a black meteoric rock in Kaaba.'));svg.appendChild(kg);
