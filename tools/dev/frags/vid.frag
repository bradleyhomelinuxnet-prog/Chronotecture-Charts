for(let y=622;y<2106;y+=50){const x1=X(y),x2=X(Math.min(y+50,2106));rg.appendChild(el('rect',{x:x1,y:RUL-8,width:x2-x1,height:16,fill:'#121a2c',stroke:'#3a486a'}));}
