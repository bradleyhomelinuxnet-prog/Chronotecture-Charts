const CAT={
  quake:{c:'#f08a4b',label:'Quakes & eruptions'},
  west:{c:'#5cb3f2',label:'Western & Aegean powers'},
  east:{c:'#9c8bf0',label:'Babylonia & Assyria'},
  islam:{c:'#37b6a6',label:'Islam & Christendom'},
  proph:{c:'#e7c355',label:'Prophetic'}
};
const ast=y=>y<0?y+1:y;
const YMIN=-700, YMAX=2140, PL=60, PR=1340;
const X=y=>PL+(ast(y)-ast(YMIN))/(ast(YMAX)-ast(YMIN))*(PR-PL);
const svg=document.getElementById('tl'), A=622, AX=X(A), AXIS=380;
for(let y=-600;y<=2100;y+=100){const x=X(y===0?1:y);svg.appendChild(el('line',{x1:x,y1:50,x2:x,y2:780,stroke:'#161f33'}));}
svg.appendChild(el('rect',{x:PL,y:AXIS-8,width:PR-PL,height:16,fill:'#121a2c',stroke:'#3a486a'}));
for(let y=-600;y<=2000;y+=200)tx(svg,X(y===0?1:y)+4,AXIS+4,y<0?(-y)+' BC':(y?y+' AD':'1 AD'),{fill:'#aeb7cd','font-size':10,class:'mono'});
const x0=X(1);svg.appendChild(el('line',{x1:x0,y1:40,x2:x0,y2:780,stroke:'#56628f','stroke-dasharray':'4 5'}));
tx(svg,x0-6,40,'BC',{'text-anchor':'end',fill:'#8b95ad','font-size':11,class:'mono'});tx(svg,x0+6,40,'AD',{fill:'#8b95ad','font-size':11,class:'mono'});
const x6=X(2106);svg.appendChild(el('line',{x1:x6,y1:40,x2:x6,y2:780,stroke:'#e7c355','stroke-width':2}));
tx(svg,x6-6,40,'2106 AD [6000 AM]',{'text-anchor':'end',fill:'#e7c355','font-size':11,class:'mono'});
svg.appendChild(el('line',{x1:AX,y1:30,x2:AX,y2:780,stroke:'#ffcf5c','stroke-width':2.2}));
const ag=el('g',{});ag.appendChild(el('path',{d:`M${AX-14} 40 L${AX+14} 40 L${AX} 64 Z`,fill:'#ffcf5c'}));
tx(ag,AX+20,40,'622 AD [4516 AM] Islamic Hijrah Calendar',{fill:'#ffcf5c','font-size':14,class:'mono','font-weight':500});
tx(ag,AX+20,58,'Mohammed’s flight from Medina · Hijrah Year One',{fill:'#ffcf5c','font-size':11.5,class:'mono'});
svg.appendChild(ag);bind(ag,T('622 AD [4516 AM]','#ffcf5c','Islamic Hijrah Calendar','Mohammed’s flight from Medina; Hijrah Year One.'));
const P=[
 {v:1085,b:-464,am:3431,e:1707,lc:'quake',l:'464 BC [3431 AM] Sparta earthquake',r:'1085 yrs. volcanic\\quakes at Santorini 1707 AD',grp:'Western and Aegean powers'},
 {v:1111,b:-490,am:3405,e:1733,lc:'west',l:'490 BC [3405 AM] Battle of Marathon [West]',r:'1111 yrs. Georgia 13th colony in the West 1733 AD',grp:'Western and Aegean powers'},
 {v:1218,b:-597,am:3298,e:1840,lc:'east',l:'597 BC [3298 AM] Babylonians sack Jerusalem',r:'1218 yrs. to 1840 AD Sir Rawlinson translates Assyrian',grp:'Both Babylonia and Assyria are now Islamic'},
 {v:1228,b:-607,am:3288,e:1850,lc:'east',l:'607 BC [3288 AM] Assyria falls to Babylonia',r:'1228 yrs to 1850 AD discovery of Assyrian library',grp:'Both Babylonia and Assyria are now Islamic'}
];
P.forEach((q,i)=>{const y=AXIS-150+i*36,xl=X(q.b),xr=X(q.e),col=CAT[q.lc].c,rx=(xr-xl)/2;
  const g=el('g',{class:'row','data-cat':q.lc});
  g.appendChild(el('path',{d:`M${xl} ${y-6} A${rx} ${110-i*12} 0 0 1 ${xr} ${y-6}`,fill:'none',stroke:col,opacity:.4}));
  g.appendChild(el('rect',{x:xl,y:y-6,width:xr-xl,height:12,rx:6,fill:col,opacity:.85}));
  g.appendChild(el('circle',{cx:AX,cy:y,r:4,fill:'#ffcf5c'}));
  tx(g,AX-8,y-10,q.l,{'text-anchor':'end',fill:'#e6ecf8','font-size':11.5,'font-weight':600,class:'h'});
  tx(g,AX+8,y-10,q.r,{fill:'#e6ecf8','font-size':11.5,'font-weight':600,class:'h'});
  g.appendChild(el('rect',{x:xl,y:y-24,width:xr-xl,height:32,fill:'transparent'}));
  bind(g,T(`${q.v} years either side`,col,`${-q.b} BC [${q.am} AM] ← 622 AD → ${q.e} AD`,`${q.l} ⇄ ${q.r}. ${q.grp}.`));svg.appendChild(g);});
tx(svg,X(-700)+4,AXIS-196,'Western and Aegean powers (first two) · Both Babylonia and Assyria are now Islamic (last two)',{fill:'#8b95ad','font-size':11,class:'h'});
spanBar(svg,{x1:X(70),x2:AX-3,y:AXIS+52,col:'#9c8bf0',cat:'east',lab:'552 years · 70 AD',lab2:'Romans destroy Jerusalem and Temple',lx:AX-12,la:'end',tip:T('552 years','#9c8bf0','70 AD ← 622 AD','Romans destroy Jerusalem and Temple.')});
const F=[
 {e:762,cat:'islam',lab:'140',l2:'762 AD Abbasid Dynasty makes Baghdad in Babylon its capital'},
 {e:1054,cat:'islam',lab:'432 [144×3] years',l2:'1054 AD supernova in Taurus and division of Roman Church'},
 {e:1062,cat:'islam',lab:'440 [40×11] years',l2:'1062 AD Muslim Turks destroy Greek Christendom.'},
 {e:2022,cat:'proph',lab:'1400 yrs. to 2022 AD Muslims defeat American forces',l2:''},
 {e:2036,cat:'proph',lab:'1414 yrs. [1000+414] to 2036 AD Antichrist defeats Muslims',l2:''},
 {e:2066,cat:'proph',lab:'1444 yrs. to 2066 AD appearance of Enoch and Elijah',l2:''}
