F.forEach((q,i)=>{const y=AXIS+110+i*46,col=CAT[q.cat].c;
  spanBar(svg,{x1:AX+3,x2:X(q.e),y,col,cat:q.cat,lab:q.lab,lab2:q.l2,lx:AX+12,la:'start',tip:T(q.lab,col,`622 AD → ${q.e} AD · ${q.e-A} years`,q.l2)});});
chips(CAT,'.row');
